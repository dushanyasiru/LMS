# ============================================================
#  Dockerfile.vercel — Spring Boot LMS on Vercel (Container / Fluid).
#  Vercel gives a container ~15s to open its port on cold start, so we
#  use CDS (Class Data Sharing) + fast-startup flags + lazy init to boot
#  fast enough. Server must listen on $PORT (default 80).
# ============================================================

# ---- Stage 1: build the jar ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -e dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

# ---- Stage 2: runtime with a prebuilt CDS archive for fast startup ----
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/lms-0.0.1.jar app.jar

# Extract the app, then do a "training run" that starts Spring and exits at
# context-refresh (no DB needed thanks to lazy init) to record a CDS archive.
RUN /opt/java/openjdk/bin/java -Djarmode=tools -jar app.jar extract --destination application \
 && /opt/java/openjdk/bin/java -XX:ArchiveClassesAtExit=application/application.jsa \
      -Dspring.context.exit=onRefresh -jar application/app.jar ; true

WORKDIR /app/application
EXPOSE 80

# Boot with the CDS archive + fast-start flags. Absolute java path because
# Vercel's runtime doesn't include the image's PATH.
CMD ["sh", "-c", "/opt/java/openjdk/bin/java -XX:SharedArchiveFile=application.jsa -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Dserver.port=${PORT:-80} -jar app.jar"]
