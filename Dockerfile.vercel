# ============================================================
#  Dockerfile.vercel — Spring Boot LMS on Vercel (Container / Fluid).
#  Vercel gives a container ~15s to open its port on cold start, so we
#  use CDS (Class Data Sharing) + fast-startup flags + lazy init to boot
#  fast enough. Server must listen on $PORT (default 80).
# ============================================================

# ---- Stage 1: build the jar ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -e dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

# ---- Stage 2: runtime with a prebuilt CDS archive for fast startup ----
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/lms-0.0.1.jar app.jar

# Extract the app into ./application. The CDS "training run" and the runtime
# CMD then run from the SAME working dir (/app/application), with the SAME jar
# (app.jar), archive (application.jsa) and JVM flags — a dynamic CDS archive is
# keyed to all of those, so any mismatch makes it "fail to load" at startup.
# We keep the JDK default GC (G1) on BOTH sides: the JDK's built-in base CDS
# archive is built for G1, and loading it under a different GC can disable it
# (which takes our dynamic archive down with it). bootstrap-mode=lazy is set
# only for the training run so context refresh completes and exits cleanly
# without a database (there is none at build time), producing a valid archive.
RUN /opt/java/openjdk/bin/java -Djarmode=tools -jar app.jar extract --destination application
WORKDIR /app/application
RUN /opt/java/openjdk/bin/java -XX:ArchiveClassesAtExit=application.jsa \
      -XX:TieredStopAtLevel=1 \
      -Dspring.data.jpa.repositories.bootstrap-mode=lazy \
      -Dspring.context.exit=onRefresh -jar app.jar ; true

# Entrypoint rewrites SPRING_DATASOURCE_URL to Supabase's transaction pooler
# (6543) — the session pooler's 15-client cap caused EMAXCONNSESSION outages —
# then boots with the CDS archive + fast-start flags. Absolute java path
# because Vercel's runtime doesn't include the image's PATH; flags/dir/jar in
# the script match the training run above so the archive loads.
COPY docker-entrypoint.sh ./entrypoint.sh

EXPOSE 80

CMD ["sh", "/app/application/entrypoint.sh"]
