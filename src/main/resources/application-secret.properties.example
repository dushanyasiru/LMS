# ============================================================
#  TEMPLATE — copy this to "application-secret.properties" and
#  fill in your real values. The real file is git-ignored.
# ============================================================

# Supabase -> Connect -> Session pooler connection string, in JDBC form:
spring.datasource.url=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
spring.datasource.username=postgres.<YOUR-PROJECT-REF>
spring.datasource.password=<YOUR-DB-PASSWORD>

app.jwt.secret=<A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS>
app.jwt.expiration-hours=12

# Teacher account created on first startup:
app.seed.teacher.email=<YOUR-EMAIL>
app.seed.teacher.name=<YOUR-NAME>
app.seed.teacher.password=<CHOOSE-A-PASSWORD>
